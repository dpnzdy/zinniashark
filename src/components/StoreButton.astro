---
import type { Locale } from '../i18n/ui';
import { writer } from '../data/adequora-writer';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
---
<a class="button store-button" href={writer.store} target="_blank" rel="noopener noreferrer">
  <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M1 1h8v8H1zm10 0h8v8h-8zM1 11h8v8H1zm10 0h8v8h-8z" /></svg>
  {locale === 'ko' ? 'Microsoft Store에서 무료 다운로드' : 'Get it free on Microsoft Store'}
  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12 12 4M4 4h8v8" /></svg>
  <span class="sr-only">{locale === 'ko' ? '(새 탭에서 열림)' : '(opens in a new tab)'}</span>
</a>
