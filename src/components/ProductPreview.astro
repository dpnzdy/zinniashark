---
import type { Locale } from '../i18n/ui';
import { writer } from '../data/adequora-writer';
interface Props { locale?: Locale; eager?: boolean }
const { locale = 'en', eager = false } = Astro.props;
const ko = locale === 'ko';
---
<figure class="product-preview">
  <a href={writer.screenshot} target="_blank" rel="noopener noreferrer" aria-label={ko ? 'ZinniaShark Note 실제 앱 화면 원본 보기 (새 탭)' : 'View the full-size ZinniaShark Note screenshot (new tab)'}>
    <img src={writer.screenshot} width="1600" height="1000" loading={eager ? 'eager' : 'lazy'} alt={ko ? 'ZinniaShark Note에서 글과 이미지를 포함한 공개 샘플 문서를 편집하는 실제 화면' : 'The ZinniaShark Note editor displaying a public sample document with text and an image'} />
  </a>
  <figcaption>{ko ? '실제 앱 화면 · 1.0.2 공개 버전 · 이전 이름이 포함된 기존 샘플 · 선택하면 원본 크기로 볼 수 있습니다.' : 'Actual app screen · 1.0.2 release · Existing sample includes the previous name · Select to view full size.'}</figcaption>
</figure>
