---
import '../styles/global.css';
import { ui, localizedPath, type Locale } from '../i18n/ui';
import { writer } from '../data/adequora-writer';

interface Props {
  title: string;
  description: string;
  path?: string;
  locale?: Locale;
  image?: string;
  imageAlt?: string;
}

const { title, description, path = '/', locale = 'en', image = '/og-image.svg', imageAlt } = Astro.props;
const socialImage = new URL(image, Astro.site);
const labels = ui[locale];
const href = (target: string) => localizedPath(target, locale);
const canonical = new URL(href(path), Astro.site);
const englishURL = new URL(localizedPath(path, 'en'), Astro.site);
const koreanURL = new URL(localizedPath(path, 'ko'), Astro.site);
const fullTitle = title === 'ZINNIASHARK' ? title : `${title} · ZINNIASHARK`;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f7f2" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={englishURL} />
    <link rel="alternate" hreflang="ko" href={koreanURL} />
    <link rel="alternate" hreflang="x-default" href={englishURL} />
    <link rel="icon" href="/images/logo.png" type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZINNIASHARK" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href={href('/')} aria-label={labels.home}>
          <img class="brand-logo" src="/images/logo.png" alt="" />
          <span>ZINNIASHARK</span>
        </a>
        <div class="header-controls">
          <nav aria-label={labels.navigation}>
            <a href={href('/products/')}>{labels.products}</a>
            <a href={href('/support/')}>{labels.support}</a>
            <a href={href('/privacy/')}>{labels.privacy}</a>
            <a href={href('/contact/')}>{labels.contact}</a>
          </nav>
          <nav class="language-switcher" aria-label={labels.languages}>
            <a href={englishURL.pathname} lang="en" hreflang="en" aria-current={locale === 'en' ? 'true' : undefined}>English</a>
            <span aria-hidden="true">|</span>
            <a href={koreanURL.pathname} lang="ko" hreflang="ko" aria-current={locale === 'ko' ? 'true' : undefined}>한국어</a>
          </nav>
        </div>
      </div>
    </header>
    <aside class="container rename-notice" role="note"><p>{locale === 'ko' ? `${writer.previousName}가 ${writer.name}로 이름을 ${writer.renamePublished ? '변경했습니다.' : '변경할 예정입니다. 현재 Store에는 이전 이름으로 표시될 수 있습니다.'}` : `${writer.previousName} ${writer.renamePublished ? 'has been renamed to' : 'will be renamed to'} ${writer.name}.${writer.renamePublished ? '' : ' The Store may still show the previous name.'}`}</p></aside>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="brand footer-brand" href={href('/')}><img class="brand-logo" src="/images/logo.png" alt="" /><span>ZINNIASHARK</span></a>
          <p>{labels.tagline}</p>
        </div>
        <div class="footer-links">
          <a href={href('/products/adequora-writer/')}>ZinniaShark Note</a>
          <a href={href('/support/')}>{labels.support}</a>
          <a href={href('/privacy/')}>{labels.privacyPolicy}</a>
          <a href={writer.privacy} hreflang="ko">{labels.appPrivacy}</a>
          <a href={href('/terms/')}>{labels.terms}</a>
          <a href={href('/contact/')}>{labels.contact}</a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} ZINNIASHARK. {labels.rights}</span>
      </div>
    </footer>
  </body>
</html>
