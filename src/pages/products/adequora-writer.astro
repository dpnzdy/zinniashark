---
import Layout from '../../layouts/Layout.astro';
const features = [
  ['Local ownership', 'Store documents directly on your computer without an account, server, or subscription.'],
  ['One file for everything', 'Keep writing, tables, images, audio, and video together in one `.adq` file.'],
  ['Strong encryption', 'Protect sensitive records with Argon2id key derivation and AES-256-GCM authenticated encryption.'],
  ['Focused editing', 'Use essential formatting, block editing, and keyboard shortcuts without a crowded interface.'],
  ['See the whole picture', 'Use outline navigation to understand long documents and jump to the right place.'],
  ['Autosave and recovery', 'Keep your work safer with automatic saving and recovery files.']
];
---
<Layout title="Adequora Writer" description="Adequora Writer is a lightweight local writing and record-keeping tool for text, structure, and multimedia." path="/products/adequora-writer/">
  <section class="page-hero product-hero"><div class="container product-hero-grid"><div><span class="eyebrow">Adequora Writer</span><h1>Keep what matters on your own computer.</h1><p>Cloud-simple, more capable than a notes app, and lighter than a word processor.</p><div class="actions"><span class="button">Coming soon to Microsoft Store</span><a class="button secondary" href="/contact/">Ask about the product</a></div></div><div class="product-image-wrap"><img src="/images/adequora-writer-image.jpeg" alt="Adequora Writer displaying text, images, and audio in one workspace" /><span class="image-badge">LOCAL · PRIVATE · YOURS</span></div></div></section>
  <section class="section"><div class="container"><div class="section-intro"><span class="eyebrow">Why Adequora Writer</span><h2>One calm place for your records.</h2><p class="muted">Adequora Writer brings the ease of notes, the structure of documents, and the flexibility of multimedia into one lightweight local file.</p></div><div class="grid">{features.map(([title, text]) => <article class="card"><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
  <section class="section tinted"><div class="container product-panel"><div><span class="eyebrow">Made for real records</span><h2>From study notes to project archives.</h2><p class="muted">Use it for learning, meetings, research, project material, or any record you want to revisit years from now—even without an internet connection.</p></div><div class="card"><h3>Built around the `.adq` format</h3><p>ADQ1 container, CBOR serialization, Deflate compression, asset integrity checks, and standard cryptographic primitives.</p></div></div></section>
  <section class="section"><div class="container"><div class="section-intro"><span class="eyebrow">Coming soon</span><h2>Be ready when it arrives.</h2><p class="muted">Adequora Writer is currently in development and planned for distribution through the Microsoft Store. The download link will be added when it is publicly available.</p><a class="button" href="/contact/">Contact ZINNIASHARK</a></div></div></section>
</Layout>
