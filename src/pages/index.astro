---
import Layout from '../layouts/Layout.astro';
---
<Layout title="ZINNIASHARK" description="ZINNIASHARK develops simple application software and mobile apps for keeping what matters." path="/">
  <section class="hero home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
      <span class="eyebrow">Application software · Mobile apps</span>
      <h1>Simple software for keeping what matters.</h1>
      <p>ZINNIASHARK develops thoughtful tools that help people organize, protect, and keep their information for the long term.</p>
      <div class="actions">
        <a class="button" href="/products/adequora-writer/">Explore Adequora Writer</a>
        <a class="button secondary" href="/contact/">Contact us</a>
      </div>
      </div>
      <div class="hero-visual">
        <div class="image-frame">
          <img src="/images/home-image.jpeg" alt="People from around the world connected through ZINNIASHARK" />
        </div>
      </div>
    </div>
  </section>

  <section class="section tinted">
    <div class="container product-panel">
      <div>
        <span class="eyebrow">Our first product</span>
        <h2>A record-keeping tool that stays with you.</h2>
        <p class="muted">Adequora Writer keeps writing, tables, images, audio, and video together in one local file. No account, server, or subscription required.</p>
        <div class="actions"><a class="button" href="/products/adequora-writer/">Discover Adequora Writer</a></div>
      </div>
      <div class="product-art" aria-label="Adequora Writer product preview">
        <div class="window-bar"><i></i><i></i><i></i></div>
        <span class="pill">LOCAL · PRIVATE · SIMPLE</span>
        <h3>Keep your thoughts in one place.</h3>
        <p>Organize your records in a lightweight `.adq` file you can keep and open yourself.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-intro"><span class="eyebrow">Our approach</span><h2>Useful by design.</h2><p class="muted">We believe software should earn its place in your workflow: clear, dependable, and respectful of your ownership.</p></div>
      <div class="grid">
        <article class="card"><div class="feature-icon">◎</div><h3>Own your files</h3><p>Your information stays in files you can keep, move, and back up yourself.</p></article>
        <article class="card"><div class="feature-icon">✦</div><h3>Less getting in the way</h3><p>Focused features and calm interfaces help you spend more time doing the work.</p></article>
        <article class="card"><div class="feature-icon">↗</div><h3>Built to last</h3><p>We make tools with long-term access and practical everyday use in mind.</p></article>
      </div>
    </div>
  </section>
</Layout>
