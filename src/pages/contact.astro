---
import Layout from '../layouts/Layout.astro';
import { writer } from '../data/adequora-writer';
---
<Layout title="Contact" description="Contact ZINNIASHARK about ZinniaShark Note, support, and business inquiries." path="/contact/">
  <section class="page-hero"><div class="container"><span class="eyebrow">Contact</span><h1>Let’s talk.</h1><p>Questions, feedback, support, or a thoughtful hello—we would be happy to hear from you.</p></div></section>
  <section class="section"><div class="container"><div class="contact-card"><span class="eyebrow">Email</span><h2>Get in touch with ZINNIASHARK.</h2><p class="muted">Company and business inquiries:</p><a class="contact-email" href="mailto:contact@zinniashark.com">contact@zinniashark.com</a><h3>ZinniaShark Note product support</h3><p class="muted">Product questions, feedback, and help with the app:</p><a class="contact-email" href={`mailto:${writer.email}`}>{writer.email}</a><p><a class="text-link" href="/support/">Read FAQs and find user guides →</a></p><p class="muted">Please include enough detail for us to understand your question. Do not include passwords, payment information, or other sensitive information in your email.</p><hr /><p><strong>지니아샥(ZINNIASHARK)</strong></p></div></div></section>
</Layout>
